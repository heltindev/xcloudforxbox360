# Xbox 360 and Visual Studio build outputs
.vs/
obj/
bin/
Release/
Debug/
dist/
*.obj
*.pch
*.pdb
*.xdb
*.tlog
*.lastbuildstate
*.cache
*.ilk
*.idb
*.sdf
*.opensdf
*.suo
*.vcxproj.user
*.user
*.log

# Compiled binaries / downloadable packages (not source code)
*.xex
*.exe
*.zip
*.xpr
*.elf
*.elf32
*.map

# Proprietary SDK-generated fonts and locally installed development tools
/assets/Fonts/
/tools/xextool/

# Local registered public Application ID (not a password, but user config).
# Publish auth_config.example.h instead.
/auth_config.h

# Standalone TLS proof-of-concept was consolidated and should not reappear.
/XBOXTERMINAL/

# Local mirror for manually reviewing source before GitHub publication
/XCloud360-GitHub-Source/

# Temporary GPL research checkout and user-supplied PS3 code base
# Reference-only original PS3/PS4 source and extracted assets are all private.
# Only the three curated context files below are public; original references remain private.
/REFERENCE_BASE/*
!/REFERENCE_BASE/AI_REFERENCE.md
!/REFERENCE_BASE/SOURCE_MAP.json
!/REFERENCE_BASE/refresh_context.ps1
/research/
/GR33N-main/
/research_pkg/
/research_tools/

# Archived XeLL/libxenon files are already covered by /REFERENCE_BASE/.

# Backups, snapshots and local exports
/archive/
/*.bak
*~
Thumbs.db
Desktop.ini

# Persistent credentials are local to the executable and must never be published.
*.authcache*

# Local IDE state and historical archives
/.vscode/
*.rar

# Clean source snapshot prepared for manual GitHub upload
/GITHUB-PAUSADO/
